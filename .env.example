# Copy to .env and fill in only the services you use.
# Shell launchers inherit exported variables. To load your own .env in Bash:
# set -a; source .env; set +a
OPENAI_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# Optional overrides (uncomment and set for your environment).
# GEMINI_JUDGE_MODEL=
# OPENAI_BASE_URL=
# HF_HOME=
# SAFEOFF_ROOT=
# PROJECT_ROOT=
# PYTHON_BIN=python
# SBATCH_ACCOUNT=
# SBATCH_PARTITION=
# SBATCH_QOS=
# SBATCH_CONSTRAINT=
WANDB_MODE=disabled
WANDB_DISABLED=true
TOKENIZERS_PARALLELISM=false
